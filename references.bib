@article{thomas2008character,
author = {Thomas, Teruji},
title = {The character of the Weil representation},
journal = {Journal of the London Mathematical Society},
volume = {77},
number = {1},
pages = {221-239},
doi = {https://doi.org/10.1112/jlms/jdm098},
url = {https://londmathsoc.onlinelibrary.wiley.com/doi/abs/10.1112/jlms/jdm098},
abstract = {Abstract Let V be a symplectic vector space over a finite or local field. We compute the character of the Weil representation of the metaplectic group Mp(V). The final formulas are overtly free of choices (for example, they do not involve the usual choice of a Lagrangian subspace of V). Along the way, in results similar to those of Maktouf, we relate the character to the Weil index of a certain quadratic form, which may be understood as a Maslov index. This relation also expresses the character as the pullback of a certain simple function from Mp(V ⊕ V).},
year = {2008}
}

