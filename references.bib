	month = jan,
	year = {2015},
	pages = {189--203},
}

@article{jaffe2016characterization,
	title = {Characterization of {Reflection} {Positivity}: {Majoranas} and {Spins}},
	volume = {346},
	issn = {1432-0916},
	url = {https://doi.org/10.1007/s00220-015-2545-z},
	doi = {10.1007/s00220-015-2545-z},
	abstract = {We study linear functionals on a Clifford algebra (algebra of Majoranas) equipped with a reflection automorphism. For Hamiltonians that are functions of Majoranas or of spins, we find necessary and sufficient conditions on the coupling constants for reflection positivity to hold. One can easily check these conditions in concrete models. We illustrate this by discussing a number of spin systems with nearest-neighbor and long-range interactions.},
	number = {3},
	journal = {Communications in Mathematical Physics},
